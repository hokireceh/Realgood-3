# =============================================================================
# Proof Gatekeeper — environment configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# NEVER paste a private key, seed phrase, or API key into a chat or a prompt.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Port / host the agent listens on. Behind a TLS-terminating reverse proxy
# (Fly.io / Railway / Render / Caddy / nginx) this is plain HTTP; the
# platform only ever sees the public HTTPS URL you register.
PORT=3000
HOST=0.0.0.0

# --- Agent Games auth (REQUIRED) ---------------------------------------------
# HMAC secret from the Agent Games dashboard: "Rotate Secret".
# Copy the ONE-TIME plaintext shown by the dashboard. A placeholder or a
# mismatched value fails preflight with a signature error.
AGENT_GAMES_HMAC_SECRET=

# HMAC algorithm for x-agent-games-signature (default: sha256).
# HMAC-SHA256 hex over the raw request/response body.
HMAC_ALGORITHM=sha256

# Optional: if set, preflight requests must carry this agent_id.
# AGENT_ID=

# --- Gatekeeper circuit (public values) --------------------------------------
# Verification-key hash registered on zkVerify mainnet for the gatekeeper
# circuit (see https://agentgames.zkverify.io/api/circuit-info).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# --- Kurier / zkVerify --------------------------------------------------------
# API key from https://kurier.xyz (mainnet) or https://testnet.kurier.xyz
# (testnet). Leave empty to disable Kurier submission (local proofs only —
# NOT recommended for scored rounds).
KURIER_API_KEY=
# Mainnet: https://api.kurier.xyz/api/v1
# Testnet: https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=https://api.kurier.xyz/api/v1
# The gatekeeper VK is already registered on mainnet (vkRegistered: true).
# Set to false on testnet if the VK has not been registered there yet —
# the agent will register it once at startup and use the returned hash.
KURIER_VK_REGISTERED=true
# Strict fail-closed mode (default true): an APPROVE requires the Kurier job
# to reach Finalized within KURIER_FINALIZE_TIMEOUT_MS. If it does not, the
# agent flips to REJECT (KURIER_NOT_FINALIZED) instead of approving.
REQUIRE_KURIER_FINALIZED=true
KURIER_FINALIZE_TIMEOUT_MS=40000
KURIER_POLL_INTERVAL_MS=5000

# --- Timing / safety -----------------------------------------------------------
# Hard response deadline (platform: 60s). The agent reserves a safety margin
# and fails closed (REJECT) if it cannot finish in time.
RESPONSE_DEADLINE_MS=60000
# Allowed clock skew for issued_at (platform timestamps).
TIMESTAMP_SKEW_MS=300000

# --- Paths ---------------------------------------------------------------------
CIRCUITS_DIR=./circuits
DATA_DIR=./data

# --- Optional in-process TLS ---------------------------------------------------
# If both are set, the agent serves HTTPS directly. Otherwise it serves HTTP
# and expects a TLS-terminating proxy in front of it.
# TLS_KEY_PATH=
# TLS_CERT_PATH=

# --- Steal the VFY (optional track) -----------------------------------------
# Strategy parameters (8 comma-separated integers) + private salt. The
# commitment = Poseidon(params, salt) is what gets registered in the
# dashboard; changing either afterwards requires re-registration.
#   params[0] extract amount (1..10)
#   params[1] fortify threshold (FORTIFY while selfBalance < this)
#   params[2] hold threshold (HOLD while opponentBalance <= this)
#   params[3] never-extract flag (0 or 1)
#   params[4..7] reserved, must be 0
STEAL_VFY_PARAMS=5,25,12,0,0,0,0,0
# Private salt (decimal or 0x-hex, non-zero, < BN128 field prime). Generate:
#   node -e "console.log('0x' + require('crypto').randomBytes(16).toString('hex'))"
# NEVER share it, never commit it. Without it the Steal track is disabled
# (turns answer 503) and the Gatekeeper track keeps working.
STEAL_VFY_SALT=

# --- Dev / test ------------------------------------------------------------------
# Set to 1 to skip the startup prover self-test (not recommended).
# SKIP_SELF_TEST=
